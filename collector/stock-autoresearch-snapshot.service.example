[Unit]
Description=Stock AutoResearch Toss Snapshot Export
After=network-online.target stock-autoresearch-toss.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stock-autoresearch
EnvironmentFile=/etc/stock-autoresearch/toss.env
ExecStart=/opt/stock-autoresearch/.venv/bin/python collector/serve_snapshot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
