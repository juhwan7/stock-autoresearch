[Unit]
Description=Stock AutoResearch Toss Market Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stock-autoresearch
EnvironmentFile=/etc/stock-autoresearch/toss.env
ExecStart=/opt/stock-autoresearch/.venv/bin/python -m autoresearch toss-collector --output /var/lib/stock-autoresearch/toss/latest.json --top-n 80 --ranking-refresh 600 --snapshot-seconds 20
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
